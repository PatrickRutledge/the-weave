{
  "name": "the-weaver",
  "version": "0.1.0",
  "description": "MCP server for structured lessons-learned retrospectives on software projects",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "the-weaver": "dist/index.js"
  },
  "files": [
    "dist",
    "perspectives",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "retrospective",
    "lessons-learned",
    "git-analysis",
    "developer-tools",
    "code-review",
    "sdlc"
  ],
  "author": "Patrick Rutledge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrickRutledge/the-weave.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "simple-git": "^3.20.0",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
